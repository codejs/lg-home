# Environment for running the app against the fake ThinQ API (npm run dev:fake).
# Loaded after .env, so these values win over your real ThinQ settings.
THINQ_API_BASE_URL=http://127.0.0.1:8090
THINQ_ACCESS_TOKEN=fake-thinq-token
THINQ_COUNTRY_CODE=US
# Keep fake devices out of the real database.
DATABASE_PATH=data/lg-home-fake.db
# Poll subscribed devices every 5 s (only allowed because the fake is local).
EVENT_POLL_INTERVAL_SECONDS=5
