# Don't run dependency install scripts (supply-chain hardening).
#
# better-sqlite3 ships prebuilt binaries, but its install script would
# otherwise run a no-op `node-gyp rebuild` that downloads Node headers from
# nodejs.org and breaks installs without internet access. On a platform
# without a prebuild, run once:
#   npm rebuild better-sqlite3 --ignore-scripts=false
ignore-scripts=true
