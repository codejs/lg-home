# Copy to .env and fill in. Never commit .env.

# Personal Access Token from the LG ThinQ developer site (Cloud Developer > Docs > ThinQ Connect > PAT)
# https://smartsolution.developer.lge.com/en/apiManage/thinq_connect
THINQ_ACCESS_TOKEN=

# Two-letter country code of your ThinQ account, e.g. US, KR, GB
THINQ_COUNTRY_CODE=US

# Optional overrides
# ThinQ API server region (AIC, EIC or KIC); normally derived from the country code
# THINQ_REGION=AIC
# Different ThinQ base URL, e.g. a mock server for testing
# THINQ_API_BASE_URL=http://localhost:8080
# Override LG's public x-api-key
# THINQ_API_KEY=
# PORT=3000
# DATABASE_PATH=data/lg-home.db

# How long a login stays valid, in hours (default 168 = 7 days). Must be a
# positive number; an invalid value stops the server at startup.
# SESSION_TTL_HOURS=168

# Force the Secure flag on the session cookie (auto-detected from the request
# protocol otherwise). Set to true when the app runs behind an HTTPS proxy.
# COOKIE_SECURE=true
