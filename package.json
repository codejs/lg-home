{
  "name": "lg-home",
  "version": "1.0.0",
  "description": "A webapp for controlling LG home appliance",
  "main": "dist/server/index.js",
  "scripts": {
    "test": "echo \"No tests yet\"",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "archive": "bash scripts/archive.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codejs/lg-home.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/codejs/lg-home/issues"
  },
  "homepage": "https://github.com/codejs/lg-home#readme",
  "packageManager": "npm@10.9.4",
  "engines": {
    "npm": "10.9.4",
    "node": "22.21.0"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "@tanstack/react-query": "5.107.1",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "thinqconnect": "0.9.10-beta"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "type": "module"
}
