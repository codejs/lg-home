{
  "name": "lg-home",
  "version": "1.0.0",
  "description": "A webapp for controlling LG home appliance",
  "main": "dist/server/index.js",
  "scripts": {
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.{ts,tsx}\"",
    "test:unit": "node --import tsx --test --test-reporter=spec \"test/unit/**/*.test.{ts,tsx}\"",
    "test:integration": "node --import tsx --test --test-reporter=spec \"test/integration/**/*.test.ts\"",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "dev:fake": "concurrently -n fake,server,web -c magenta,blue,green \"npm:fake-thinq\" \"npm:dev:server:fake\" \"npm:dev:web\"",
    "dev:server:fake": "tsx watch --env-file-if-exists=.env --env-file=test/fake-thinq/fake.env src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "add_user": "tsx --env-file-if-exists=.env src/server/cli/add-user.ts",
    "add_user:fake": "tsx --env-file-if-exists=.env --env-file=test/fake-thinq/fake.env src/server/cli/add-user.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "archive": "bash scripts/archive.sh",
    "fake-thinq": "tsx test/fake-thinq/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codejs/lg-home.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/codejs/lg-home/issues"
  },
  "homepage": "https://github.com/codejs/lg-home#readme",
  "packageManager": "npm@10.9.4",
  "engines": {
    "npm": "10.9.4",
    "node": "22.21.0"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@tanstack/react-query": "5.107.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "5.0.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "type": "module"
}
